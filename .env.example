# Copy to .env.local for local dev — never commit .env.local

# ── Clerk auth (required to enforce sign-in before checkout) ──
# Get these from https://dashboard.clerk.com → your app → API Keys.
# Until BOTH are set, the site runs with auth disabled: checkout is
# NOT gated and users are NOT synced to Supabase.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Supabase (stores the user base + orders) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional, only needed to run tests/unit/rls.test.js (RLS regression test).
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ── Misc ──
RESEND_API_KEY=re_your_resend_key
UPI_VPA=9560397569@ptaxis
UPI_DISPLAY_NAME=AthenaBioLabs
ADMIN_EMAILS=admin@athenabiolabs.com
ADMIN_SITE_URL=https://athenabiolabs.com
